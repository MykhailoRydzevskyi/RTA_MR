{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlertEvent",
  "description": "Event published to inventory.alerts when stock falls below reorder level.",
  "type": "object",
  "required": ["alert_id", "product_id", "severity", "quantity_on_hand", "reorder_level", "timestamp"],
  "properties": {
    "alert_id": { "type": "string", "example": "ALR-0001" },
    "product_id": { "type": "string", "example": "P001" },
    "severity": { "type": "string", "enum": ["LOW_STOCK", "CRITICAL", "OUT_OF_STOCK"], "example": "LOW_STOCK" },
    "quantity_on_hand": { "type": "integer", "minimum": 0, "example": 8 },
    "reorder_level": { "type": "integer", "minimum": 0, "example": 10 },
    "timestamp": { "type": "string", "format": "date-time", "example": "2026-06-05T10:15:00" }
  },
  "additionalProperties": false
}
