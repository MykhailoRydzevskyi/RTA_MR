{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PurchaseOrderEvent",
  "description": "Event published to orders.purchase when a purchase order is created or updated.",
  "type": "object",
  "required": ["order_id", "supplier_id", "items", "status", "timestamp"],
  "properties": {
    "order_id": { "type": "string", "example": "PO-0001" },
    "supplier_id": { "type": "string", "example": "SUP-01" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["product_id", "quantity"],
        "properties": {
          "product_id": { "type": "string", "example": "P001" },
          "quantity": { "type": "integer", "minimum": 1, "example": 50 }
        },
        "additionalProperties": false
      }
    },
    "status": { "type": "string", "enum": ["CREATED", "SENT", "CONFIRMED", "DELIVERED", "CANCELLED"], "example": "CREATED" },
    "timestamp": { "type": "string", "format": "date-time", "example": "2026-06-05T10:15:00" }
  },
  "additionalProperties": false
}
