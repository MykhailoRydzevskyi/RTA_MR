# === Host serwera (osoba uruchamiajaca docker compose) ===
# Ustaw KAFKA_EXTERNAL_HOST na IP tego komputera w sieci LAN (np. 192.168.1.50).
# Sprawdz: w PowerShell wpisz  ipconfig  i szukaj IPv4 (Wi-Fi / Ethernet).
KAFKA_EXTERNAL_HOST=localhost

KAFKA_BOOTSTRAP_INTERNAL=broker:9092
KAFKA_BOOTSTRAP_HOST=localhost:29092
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
REDIS_HOST=redis
REDIS_PORT=6379
JUPYTER_TOKEN=root
